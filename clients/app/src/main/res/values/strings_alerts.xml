    <!-- Titles about another device take its subject (subject_* in strings_guidance.xml) and follow notify.ts. -->
    <string name="event_login_title">%1$s tried to sign in to your DeKoi</string>
    <string name="event_login_action">Tried to sign in</string>
    <string name="event_login_consequence">Someone may be trying to get into the devices on your network.</string>
    <string name="event_login_why">Nothing on your network has a reason to sign in to your DeKoi. Someone, or a program, is trying passwords on the devices it finds.</string>
    <string name="event_connection_title">%1$s opened one of your decoys</string>
    <string name="event_connection_action">Opened a decoy</string>
    <string name="event_connection_why">Your DeKoi pretends to be a storage box. Ordinary devices leave it alone, so a visit means something on your network is looking around.</string>
    <string name="event_probe_consequence">Something on your network may be looking for a way in.</string>
    <string name="event_scan_title">%1$s searched your network for openings</string>
    <string name="event_scan_action">Searched for openings</string>
    <string name="event_scan_why">It tried many openings on your DeKoi in a short time, looking for a way in. Network tools do this, and so do harmful programs.</string>
    <string name="event_host_scan_title">%1$s searched your whole network</string>
    <string name="event_host_scan_action">Searched the whole network</string>
    <string name="event_host_scan_consequence">Something on your network may be mapping your devices.</string>
    <string name="event_host_scan_why">It asked for the addresses of many devices in a short time. Network tools do this, and so do harmful programs looking for other devices.</string>
    <string name="event_arp_spoof_title">%1$s is pretending to be another device</string>
    <string name="event_arp_spoof_action">Pretended to be another device</string>
    <string name="event_arp_spoof_consequence">It could read or change your internet traffic.</string>
    <string name="event_arp_spoof_why">It claimed an address that belongs to another device on your network, so traffic meant for that device can go to it instead.</string>
    <string name="event_rogue_dhcp_title">%1$s is handing out network settings</string>
    <string name="event_rogue_dhcp_action">Handed out network settings</string>
    <string name="event_rogue_dhcp_why">Normally only your router gives devices their network settings. Another device doing it can send your traffic through itself.</string>
    <string name="event_rogue_router_title">%1$s announces itself as your router</string>
    <string name="event_rogue_router_action">Announced itself as a router</string>
    <string name="event_rogue_router_why">A new device started announcing itself as a router. Some smart home hubs do this, but it can also redirect your devices’ traffic through it.</string>
    <string name="event_redirect_consequence">It could send your devices’ traffic through itself.</string>
    <string name="event_name_poisoning_title">%1$s answers questions it should not</string>
    <string name="event_name_poisoning_action">Answered for a computer that does not exist</string>
    <string name="event_name_poisoning_consequence">It could trick computers into handing over passwords.</string>
    <string name="event_name_poisoning_why">Your DeKoi asked for a computer that does not exist, and something answered. Tools that do this trick computers into handing over passwords.</string>
    <string name="event_ids_title">%1$s sent suspicious traffic to your DeKoi</string>
    <string name="event_ids_action">Sent suspicious traffic</string>
    <string name="event_ids_consequence">A device on your network may be running a harmful program.</string>
    <string name="event_ids_why">The traffic matched a known pattern of attacks or harmful programs. The technical details name the pattern.</string>
    <string name="event_new_host_title">%1$s joined your network for the first time</string>
    <string name="event_new_host_action">Joined your network</string>
    <string name="event_new_host_consequence">If no one in your home knows it, someone may be using your Wi-Fi without asking.</string>
    <string name="event_new_host_why">Your DeKoi saw this device on your network for the first time. Usually it is a new phone, a guest or a smart home gadget.</string>
    <string name="event_offline_title">Your DeKoi went offline</string>
    <string name="event_offline_action">Went offline</string>
    <string name="event_offline_consequence">Your DeKoi can’t warn you until it is back.</string>
    <string name="event_offline_why">Usually it is a power cut, an unplugged cable or a router restart.</string>
    <string name="event_online_title">Your DeKoi is online</string>
    <string name="event_online_action">Came back online</string>
    <string name="event_online_consequence">Your DeKoi is watching your network.</string>
    <string name="event_online_why">Your DeKoi checks in every minute and is watching your network.</string>
    <string name="event_other_title">Activity on your DeKoi</string>
    <string name="event_other_action">Activity</string>
    <string name="event_other_consequence">Your DeKoi noticed something it has no plain description for yet.</string>
    <string name="event_other_why">This happens when your DeKoi is newer than the app. The technical details show what it saw.</string>

    <string name="alert_fact_decoys">It went for these decoys: %1$s.</string>
    <string name="alert_fact_openings">Among the openings it tried were %1$s.</string>
    <string name="alert_fact_router">It claimed your router’s address, so your devices may be sending their internet traffic to it.</string>

