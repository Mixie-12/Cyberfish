<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon's monochrome layer, which the launcher tints: the mark
     (@string/mark_path, res/README.md) placed as in
     clients/app/icon/launcher-foreground.svg. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1536"
    android:viewportHeight="1536">
    <group
        android:translateX="256"
        android:translateY="256">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="@string/mark_path" />
    </group>
</vector>
