<?xml version="1.0" encoding="utf-8"?>
<!-- The status bar icon: the mark (@string/mark_path, res/README.md) in
     white, 22 dp wide. The viewport is the middle 70 % of the app icon's
     1024 units, which centres the mark. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="716.8"
    android:viewportHeight="716.8">
    <group
        android:translateX="-153.6"
        android:translateY="-153.6">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="@string/mark_path" />
    </group>
</vector>
