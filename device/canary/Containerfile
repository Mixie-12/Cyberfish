# dekoi-canary: the OpenCanary decoys. Build context: device/
FROM docker.io/library/python:3.13-slim-trixie@sha256:09a17cad02668ae61ece136b4fd36ac3849e14f670ebedb637ea3e15580525bc AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential \
 && rm -rf /var/lib/apt/lists/*
COPY canary/requirements.txt /tmp/requirements.txt
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir --disable-pip-version-check --require-hashes \
    -r /tmp/requirements.txt

FROM docker.io/library/python:3.13-slim-trixie@sha256:09a17cad02668ae61ece136b4fd36ac3849e14f670ebedb637ea3e15580525bc
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin canary \
 && install -d -o canary -g canary -m 0755 /var/log/opencanary \
 && install -d -o canary -g canary -m 0700 /var/lib/opencanary
COPY --from=build /opt/venv /opt/venv
COPY canary/opencanary.conf /etc/opencanaryd/opencanary.conf
COPY agent/dekoi_agent/decoys.py /opt/dekoi/decoys.py
# Release version (the same build argument for every image) and build time,
# reported in the agent's heartbeat (ADR 0013).
ARG DEKOI_AGENT_VERSION=dev
RUN install -d /usr/share/dekoi \
 && printf '%s %s\n' "$DEKOI_AGENT_VERSION" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > /usr/share/dekoi/image
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp
USER 10001
WORKDIR /tmp
# twistd directly: the opencanaryd wrapper needs sudo and a writable /var/run.
# The image file is copied into the log volume first, the only place of this
# container the agent can read. A failed copy is logged and never keeps the
# decoys from starting; a link left in its place is replaced, not followed.
ENTRYPOINT ["/bin/sh", "-c", "cp --remove-destination /usr/share/dekoi/image /var/log/opencanary/image || echo 'image file not copied' >&2; exec twistd --nodaemon --pidfile= --python=/opt/venv/bin/opencanary.tac"]
