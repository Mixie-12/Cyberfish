# dekoi-canary: the decoys. Build context: device/
# One image, two containers (ADR 0018): dekoi-canary runs OpenCanary and the
# Samba file share; dekoi-announce runs what makes them visible on the
# network (NetBIOS names, mDNS, WS-Discovery). The persona (canary/persona)
# is filled into the configuration at build time.
FROM docker.io/library/python:3.13-slim-trixie@sha256:09a17cad02668ae61ece136b4fd36ac3849e14f670ebedb637ea3e15580525bc AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential \
 && rm -rf /var/lib/apt/lists/*
COPY canary/requirements.txt /tmp/requirements.txt
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir --disable-pip-version-check --require-hashes \
    -r /tmp/requirements.txt
COPY canary/render.py /tmp/render.py
COPY canary/persona /tmp/persona
WORKDIR /tmp/persona
RUN python /tmp/render.py persona.json /tmp/rendered smb.conf avahi-daemon.conf \
    skin/index.html skin/403.html skin/404.html skin/redirect.html

FROM docker.io/library/python:3.13-slim-trixie@sha256:09a17cad02668ae61ece136b4fd36ac3849e14f670ebedb637ea3e15580525bc
# avahi-daemon refuses to start unless its runtime directory belongs to its
# own user; Podman copies /run from the image into the container's tmpfs.
RUN apt-get update \
 && apt-get install -y --no-install-recommends samba avahi-daemon wsdd2 \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin canary \
 && install -d -o canary -g canary -m 0755 /var/log/opencanary \
 && install -d -o canary -g canary -m 0700 /var/lib/opencanary \
 && install -d -o avahi -g avahi -m 0755 /run/avahi-daemon \
 && install -d -m 0755 /srv/decoy/locked
COPY --from=build /opt/venv /opt/venv
COPY --from=build /tmp/rendered/smb.conf /etc/samba/smb.conf
COPY --from=build /tmp/rendered/avahi-daemon.conf /etc/avahi/avahi-daemon.conf
COPY --from=build /tmp/rendered/skin /opt/dekoi/skin
COPY canary/persona/decoy.service /etc/avahi/services/decoy.service
COPY canary/persona/public /srv/decoy/Public
COPY canary/opencanary.conf /etc/opencanaryd/opencanary.conf
COPY canary/supervise.py agent/dekoi_agent/decoys.py /opt/dekoi/
# Release version (the same build argument for every image) and build time,
# reported in the agent's heartbeat (ADR 0013).
ARG DEKOI_AGENT_VERSION=dev
RUN install -d /usr/share/dekoi \
 && printf '%s %s\n' "$DEKOI_AGENT_VERSION" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > /usr/share/dekoi/image
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp
USER 10001
WORKDIR /tmp
ENTRYPOINT ["python", "/opt/dekoi/supervise.py"]
CMD ["canary"]
