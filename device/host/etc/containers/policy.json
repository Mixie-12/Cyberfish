{
  "default": [{"type": "reject"}],
  "transports": {
    "docker": {
      "ghcr.io/mixie-12/dekoi-agent": [
        {
          "type": "sigstoreSigned",
          "keyPaths": ["/etc/dekoi/cosign.pub"],
          "signedIdentity": {"type": "matchRepository"}
        }
      ],
      "ghcr.io/mixie-12/dekoi-canary": [
        {
          "type": "sigstoreSigned",
          "keyPaths": ["/etc/dekoi/cosign.pub"],
          "signedIdentity": {"type": "matchRepository"}
        }
      ],
      "ghcr.io/mixie-12/dekoi-ids": [
        {
          "type": "sigstoreSigned",
          "keyPaths": ["/etc/dekoi/cosign.pub"],
          "signedIdentity": {"type": "matchRepository"}
        }
      ]
    }
  }
}
