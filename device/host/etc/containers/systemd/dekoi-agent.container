# The agent. Needs the host network namespace and CAP_NET_RAW for arp-scan,
# so it cannot use a user namespace; it runs as uid 10002 with only that one
# capability. It reads the decoy and firewall logs and the host's Wi-Fi scan
# read-only, and writes only the country the Wi-Fi scan may use (ADR 0019).
[Unit]
Description=DeKoi agent
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target dekoi-canary.service

[Container]
ContainerName=dekoi-agent
Image=ghcr.io/mixie-12/dekoi-agent:stable
AutoUpdate=registry
Network=host
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
AddCapability=NET_RAW
Tmpfs=/tmp
Volume=dekoi-agent-state:/var/lib/dekoi-agent:U
Volume=dekoi-ids-socket:/run/dekoi-ids:U
Volume=dekoi-canary-log:/var/log/opencanary:ro
Volume=/var/log/ulog:/var/log/ulog:ro
Volume=/etc/dekoi/claim-code:/etc/dekoi/claim-code:ro
Volume=/run/dekoi/wifi:/run/dekoi/wifi:ro
Volume=/run/dekoi/wifi-country:/run/dekoi/wifi-country
Notify=true

[Service]
Restart=always
RestartSec=10
# The first start pulls the image; the device is not registered yet, so the
# agent is ready as soon as it runs. Later starts are ready once the backend
# has accepted a heartbeat: 15 minutes leave room for four attempts, after
# which podman auto-update rolls back an image that cannot reach the backend.
TimeoutStartSec=900
# The agent pings after every pass of its loop; a pass that hangs gets the
# agent restarted before the backend counts the device as offline (30
# minutes). The slowest healthy pass, with every check due and the backend
# timing out, stays under ten minutes (arp-scan at most 2 minutes, each
# request 20 s, UPnP and the speed test 30 s each). Tested with Podman 5.4.2
# and systemd 257: the pings reach systemd through Notify=true.
WatchdogSec=15min

[Install]
WantedBy=multi-user.target
